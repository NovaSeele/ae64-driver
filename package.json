{
  "name": "ae64-control",
  "description": "Local-first WebHID driver for the Everglide AE64 family (Max, Pro)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "build:desktop": "vue-tsc --noEmit && vite build --mode desktop",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build && node scripts/desktop/portable-zip.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-vue": "^3.50.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
